\newcommand{\studentdetails}{%
  \section*{\centering STUDENT DETAILS}
  \begin{tabularx}{\textwidth}{@{}X X@{}}
    \textbf{Name of Student:} \fillfield{\StudentName}{4.5cm} &
    \textbf{University Roll No.:} \fillfield{\RollNo}{3.5cm}\\[6pt]
    \textbf{Batch:} \fillfield{\Batch}{4.5cm} &
    \textbf{Group No.:} \fillfield{\GroupNo}{3.5cm}\\[6pt]
    \textbf{Date of Submission:} \fillfield{\SubmissionDate}{3cm} &
    \textbf{Student Signature:} \fillfield{}{3.2cm}
  \end{tabularx}}

